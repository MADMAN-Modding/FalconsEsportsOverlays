{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Falcons Esports Overlays Controller",
  "version": "3.3.0",
  "identifier": "com.madman-modding.falcons-esports-overlays-controller",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Falcons Esports Overlays Controller",
        "width": 1386,
        "height": 850
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
